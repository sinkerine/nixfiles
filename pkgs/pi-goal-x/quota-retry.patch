+/**
+ * Usage-limit recovery: with PI_GOAL_QUOTA_URL set, a goal stopped by a
+ * provider usage limit waits for the soonest quota reset reported by magpie
+ * instead of retrying on the network-error ladder.
+ */
+
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+
+import piGoalExtension from "../extensions/goal.ts";
+import {
+	createGoal,
+	goalFocusDetails,
+	type GoalRecord,
+	type GoalStateEntry,
+} from "../extensions/goal-record.ts";
+import { endsWithUsageLimitAssistantMessage, isNetworkErrorAssistantMessage } from "../extensions/goal-format.ts";
+import { saveGoalSettingsFileConfig } from "../extensions/goal-settings.ts";
+import type { GoalCore } from "../extensions/goal-state.ts";
+import {
+	QUOTA_FALLBACK_DELAY_MS,
+	QUOTA_RESET_GRACE_MS,
+	QUOTA_RETRY_URL_ENV,
+	fetchQuotaRetryPlan,
+	quotaAvailablePlan,
+} from "../extensions/quota-retry.ts";
+
+const USAGE_LIMIT_MESSAGE =
+	'429: {"code":null,"message":"Codex: The usage limit has been reached","param":null,"type":"rate_limit_error"}';
+
+const FIXTURE_GOAL = readFileSync(
+	new URL("./fixtures/goals/active_goal_fixture.md", import.meta.url),
+	"utf8",
+);
+
+// ── Harness (mirrors tests/goal-stale-continuation-golden.test.ts) ──────────
+
+interface HandlerMap {
+	[key: string]: (event: any, ctx: ExtensionContext) => Promise<unknown> | unknown;
+}
+
+function createHarness(cwd: string) {
+	const handlers: HandlerMap = {};
+	const sentMessages: Array<{ customType?: string; details?: unknown }> = [];
+	const notifications: Array<{ message: string; level?: string }> = [];
+	let aborts = 0;
+
+	const mockPi = {
+		registerTool: () => {},
+		registerCommand: () => {},
+		on: (event: string, handler: (...args: never[]) => unknown) => {
+			handlers[event] = handler as HandlerMap[string];
+		},
+		appendEntry: () => {},
+		registerMessageRenderer: () => {},
+		sendMessage: (msg: { customType?: string; details?: unknown }) => {
+			sentMessages.push(msg);
+		},
+		sendUserMessage: () => {},
+		getActiveTools: () => ["read", "bash", "edit", "write"],
+		setActiveTools: () => {},
+		hasUI: false,
+	};
+
+	const ctx = {
+		cwd,
+		hasUI: false,
+		sessionManager: {
+			getBranch: () => [],
+			getCwd: () => cwd,
+			getSessionId: () => "test-session",
+			getRoot: () => cwd,
+			append: () => {},
+			appendModelChange: () => {},
+			appendThinkingLevelChange: () => {},
+			appendCompetingWriteCheck: () => {},
+			buildSessionContext: () => ({ messages: [], sessionId: "test", model: null, thinkingLevel: "medium" }),
+		},
+		getSystemPrompt: () => "",
+		isIdle: () => false,
+		hasPendingMessages: () => true,
+		abort: () => {
+			aborts++;
+		},
+		ui: { notify: (message: string, level?: string) => notifications.push({ message, level }) },
+	} as unknown as ExtensionContext & { abort: () => void };
+
+	piGoalExtension(mockPi as never);
+
+	return {
+		core: (mockPi as unknown as { _goalCore: GoalCore })._goalCore,
+		handlers,
+		sentMessages,
+		notifications,
+		get aborts() {
+			return aborts;
+		},
+		ctx,
+	};
+}
+
+function fixtureCwd(): { cwd: string; goal: GoalRecord } {
+	const cwd = mkdtempSync(path.join(tmpdir(), "goal-quota-retry-"));
+	mkdirSync(path.join(cwd, ".pi", "goals", "archived"), { recursive: true });
+	writeFileSync(path.join(cwd, ".pi", "goals", "active_goal_fixture.md"), FIXTURE_GOAL);
+	const parsed = createGoal(
+		{ objective: "Golden fixture goal objective", autoContinue: true, sisyphus: false },
+		Date.UTC(2026, 7, 3, 9, 0, 0),
+	);
+	return { cwd, goal: { ...parsed, id: "golden_fixture_goal" } };
+}
+
+function sessionEntriesFor(goal: GoalRecord) {
+	const stateEntry: GoalStateEntry = {
+		version: 3,
+		goal: {
+			...goal,
+			activePath: ".pi/goals/active_goal_fixture.md",
+			usage: { tokensUsed: 0, activeSeconds: 0 },
+			taskList: undefined,
+			verificationContract: undefined,
+		},
+	};
+	return [
+		{ type: "custom", customType: "pi-goal-focus", data: goalFocusDetails(goal.id, "created") },
+		{ type: "custom", customType: "pi-goal-state", data: stateEntry },
+	];
+}
+
+async function startSession(handlers: HandlerMap, ctx: ExtensionContext, entries: unknown[]) {
+	const ss = handlers["session_start"];
+	assert.ok(ss, "session_start handler must be registered");
+	await ss({ reason: "start" }, {
+		...ctx,
+		sessionManager: { ...ctx.sessionManager, getBranch: () => entries },
+	} as unknown as ExtensionContext);
+}
+
+/** Idle ctx: continuation fires immediately instead of rescheduling. */
+function idleCtx(ctx: ExtensionContext): ExtensionContext {
+	return {
+		...ctx,
+		isIdle: () => true,
+		hasPendingMessages: () => false,
+	} as unknown as ExtensionContext;
+}
+
+async function countCheckpoints(h: ReturnType<typeof createHarness>): Promise<number> {
+	await new Promise((resolve) => setTimeout(resolve, 20));
+	return h.sentMessages.filter(
+		(m) => m.customType === "pi-goal-event" && (m.details as { kind?: string } | undefined)?.kind === "checkpoint",
+	).length;
+}
+
+async function markGoalWork(h: ReturnType<typeof createHarness>): Promise<void> {
+	await h.handlers["turn_start"]!({}, h.ctx);
+	await h.handlers["tool_call"]!({ toolName: "bash", args: { command: "ls" } }, h.ctx);
+	await h.handlers["tool_execution_end"]!({}, h.ctx);
+	assert.equal(h.core.scheduler.declare(h.ctx, { kind: "ready" }).terminate, true);
+}
+
+
+async function serveQuotas(body: unknown): Promise<{ url: string; close: () => void }> {
+	const server = createServer((_req, res) => {
+		res.setHeader("content-type", "application/json");
+		res.end(JSON.stringify(body));
+	});
+	await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+	const address = server.address();
+	assert.ok(address && typeof address === "object");
+	return { url: `http://127.0.0.1:${address.port}/api/usage/quotas`, close: () => server.close() };
+}
+
+async function startGoalRun(h: ReturnType<typeof createHarness>, goal: GoalRecord): Promise<void> {
+	await startSession(h.handlers, h.ctx, sessionEntriesFor(goal));
+	await h.handlers["before_agent_start"]!({
+		systemPrompt: "base",
+		prompt: "user typed: continue",
+		systemPromptOptions: {},
+	}, h.ctx);
+}
+
+async function failOnUsageLimit(h: ReturnType<typeof createHarness>): Promise<void> {
+	await h.handlers["agent_end"]!({
+		messages: [{ role: "assistant", stopReason: "error", errorMessage: USAGE_LIMIT_MESSAGE }],
+	}, idleCtx(h.ctx));
+	await h.handlers["agent_settled"]!({}, idleCtx(h.ctx));
+}
+
+async function until(check: () => boolean, ms = 2_000): Promise<void> {
+	const deadline = Date.now() + ms;
+	while (!check()) {
+		if (Date.now() > deadline) throw new Error("condition not reached");
+		await new Promise(resolve => setTimeout(resolve, 5));
+	}
+}
+
+// ── Planning ────────────────────────────────────────────────────────────────
+
+test("plan: an account returns once all its exhausted windows reset; the soonest account wins", () => {
+	const now = Date.parse("2026-10-25T19:00:00-07:00");
+	const plan = quotaAvailablePlan([
+		{ provider: "codex", user: "a", windows: [
+			{ used: 100, resetsAt: "2026-10-25T20:00:00-07:00" },
+			{ used: 100, resetsAt: "2026-10-26T00:00:00-07:00" },
+		] },
+		{ provider: "codex", user: "b", windows: [
+			{ used: 100, resetsAt: "2026-10-25T22:00:00-07:00" },
+			{ used: 10, resetsAt: "2026-10-31T00:00:00-07:00" },
+		] },
+		{ provider: "key", user: "unlimited", windows: [{ unlimited: true, used: 0 }] },
+		{ provider: "codex", user: "unknown reset", windows: [{ used: 100 }] },
+	], now);
+	assert.deepEqual(plan, { at: Date.parse("2026-10-25T22:00:00-07:00"), reason: "codex b" });
+	assert.equal(quotaAvailablePlan([{ windows: [{ used: 40 }] }], now)?.at, now, "an account with allowance is available now");
+	assert.equal(quotaAvailablePlan([], now), undefined);
+});
+
+test("plan: reads both the GUI array and the /v1/magpie/quotas list shape, with fallbacks", async () => {
+	const now = Date.now();
+	const reset = new Date(now + 3_600_000).toISOString();
+	const cards = [{ provider: "codex", user: "a", windows: [{ used: 100, resetsAt: reset }] }];
+	for (const body of [cards, { object: "list", data: cards }]) {
+		const server = await serveQuotas(body);
+		try {
+			const plan = await fetchQuotaRetryPlan(server.url, now);
+			assert.equal(plan.at, Date.parse(reset) + QUOTA_RESET_GRACE_MS);
+			assert.match(plan.reason, /codex a resets/);
+		} finally { server.close(); }
+	}
+	const left = await serveQuotas([{ provider: "codex", user: "a", windows: [{ used: 20 }] }]);
+	try {
+		assert.equal((await fetchQuotaRetryPlan(left.url, now)).at, now + QUOTA_FALLBACK_DELAY_MS);
+	} finally { left.close(); }
+	const failed = await fetchQuotaRetryPlan("http://127.0.0.1:1/api/usage/quotas", now);
+	assert.equal(failed.at, now + QUOTA_FALLBACK_DELAY_MS);
+	assert.match(failed.reason, /quota read failed/);
+});
+
+test("classification: the magpie Codex usage limit is a usage limit (and still transient)", () => {
+	assert.equal(endsWithUsageLimitAssistantMessage([{ role: "assistant", stopReason: "error", errorMessage: USAGE_LIMIT_MESSAGE }]), true);
+	assert.equal(isNetworkErrorAssistantMessage({ role: "assistant", stopReason: "error", errorMessage: USAGE_LIMIT_MESSAGE }), true);
+	assert.equal(endsWithUsageLimitAssistantMessage([
+		{ role: "assistant", stopReason: "error", errorMessage: USAGE_LIMIT_MESSAGE },
+		{ role: "assistant", stopReason: "stop" },
+	]), false, "a later successful reply supersedes the limit");
+	assert.equal(endsWithUsageLimitAssistantMessage([{ role: "assistant", stopReason: "error", errorMessage: "503 server_error" }]), false);
+});
+
+// ── Lifecycle ───────────────────────────────────────────────────────────────
+
+test("lifecycle: a usage limit schedules recovery at the quota reset and a user turn cancels it", async () => {
+	const reset = Date.now() + 3_600_000;
+	const server = await serveQuotas([{ provider: "codex", user: "a", windows: [{ used: 100, resetsAt: new Date(reset).toISOString() }] }]);
+	process.env[QUOTA_RETRY_URL_ENV] = server.url;
+	const { cwd, goal } = fixtureCwd();
+	saveGoalSettingsFileConfig(cwd, { maxAutonomousRuns: 100 });
+	const h = createHarness(cwd);
+	try {
+		await startGoalRun(h, goal);
+		await failOnUsageLimit(h);
+		await until(() => h.core.runtime.getQuotaRetryAt() !== null);
+		assert.equal(h.core.runtime.getQuotaRetryAt(), reset + QUOTA_RESET_GRACE_MS);
+		assert.match(h.notifications.at(-1)?.message ?? "", /usage limit reached\. Retrying the goal at .*codex a resets/);
+		assert.equal(h.notifications.some(n => /Retrying the goal in \d+s/.test(n.message)), false, "the network ladder stays off");
+		assert.equal(h.core.state.goal?.status, "active", "the goal stays active while it waits");
+
+		await h.handlers["before_agent_start"]!({ systemPrompt: "base", prompt: "user typed: something else", systemPromptOptions: {} }, h.ctx);
+		assert.equal(h.core.runtime.getQuotaRetryAt(), null, "a user turn takes over from the wait");
+	} finally {
+		delete process.env[QUOTA_RETRY_URL_ENV];
+		server.close();
+	}
+});
+
+test("lifecycle: the quota retry recovers the goal when it fires", async () => {
+	const { cwd, goal } = fixtureCwd();
+	saveGoalSettingsFileConfig(cwd, { maxAutonomousRuns: 100 });
+	const h = createHarness(cwd);
+	await startGoalRun(h, goal);
+	await h.handlers["agent_end"]!({ messages: [{ role: "assistant", stopReason: "stop" }] }, idleCtx(h.ctx));
+	await h.handlers["agent_settled"]!({}, idleCtx(h.ctx));
+	const before = await countCheckpoints(h);
+	assert.equal(h.core.runtime.scheduleQuotaRetry(idleCtx(h.ctx), h.core.state.goal!, Date.now() + 20), true);
+	await new Promise(resolve => setTimeout(resolve, 60));
+	assert.ok(await countCheckpoints(h) > before, "recovery dispatches a goal checkpoint");
+	assert.equal(h.core.runtime.getQuotaRetryAt(), null);
+});
+
+test("lifecycle: without PI_GOAL_QUOTA_URL a usage limit keeps the network-error ladder", async () => {
+	delete process.env[QUOTA_RETRY_URL_ENV];
+	const { cwd, goal } = fixtureCwd();
+	saveGoalSettingsFileConfig(cwd, { maxAutonomousRuns: 100 });
+	const h = createHarness(cwd);
+	await startGoalRun(h, goal);
+	await failOnUsageLimit(h);
+	assert.match(h.notifications.at(-1)?.message ?? "", /Retrying the goal in 5s/);
+	assert.equal(h.core.runtime.getQuotaRetryAt(), null);
+});
