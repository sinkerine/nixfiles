+/** A provider usage limit (Codex/magpie "usage limit has been reached", quota exhaustion). */
+const USAGE_LIMIT_ERROR_RE = /\busage limit\b|\binsufficient[_\s]?quota\b|\bquota exceeded\b|\bout of budget\b|UsageLimitError/i;
+
+export function isUsageLimitAssistantMessage(message: unknown): boolean {
+	if (!isErrorAssistantMessage(message)) return false;
+	const raw = asRecord(message);
+	const details = [raw?.rawStopReason, raw?.errorMessage]
+		.filter((value): value is string => typeof value === "string")
+		.join(" ");
+	return USAGE_LIMIT_ERROR_RE.test(details);
+}
+
+/** Only the run's final assistant message decides: a later success supersedes an earlier limit. */
+export function endsWithUsageLimitAssistantMessage(messages: unknown[]): boolean {
+	for (let i = messages.length - 1; i >= 0; i--) {
+		if (asRecord(messages[i])?.role === "assistant") return isUsageLimitAssistantMessage(messages[i]);
+	}
+	return false;
+}
