+test("Paseo handoff wait survives unrelated notifications and consumes one native delivery", async t => {
+ const h = await fixture(t);
+ t.mock.timers.enable({apis: ["setTimeout", "Date"]});
+ h.begin();
+ assert.equal(h.core.scheduler.declare(h.ctx, {kind: "wait", reason: "SDK dependency", deadline: new Date(Date.now()+60_000).toISOString(), message: {source_agent_id: "sdk-agent", prefix: "SDK_READY"}}).terminate, true);
+ h.core.scheduler.settled(h.ctx); t.mock.timers.tick(20_000);
+ assert.equal(h.sent.length, 0);
+ const envelope = (source: string, body: string) => ({role: "user", content: [{type: "text", text: `<paseo-system version="1" kind="agent-message" source-agent-id="${source}">${body}</paseo-system>`}]});
+ for (const message of [{role:"custom",customType:"subagent-notify"}, envelope("other-agent","SDK_READY abc"), envelope("sdk-agent","SDK_READYNESS abc")]) {
+  h.begin(); h.core.scheduler.message(h.ctx,message); h.core.scheduler.settled(h.ctx); t.mock.timers.tick(1);
+  assert.equal(h.core.state.goal?.scheduler?.phase,"waiting");
+  assert.equal(h.sent.length,0,"no checkpoint or contract repair for unrelated messages");
+ }
+ h.begin(); h.core.scheduler.message(h.ctx,envelope("sdk-agent","SDK_READY abc"));
+ assert.equal(h.core.state.goal?.scheduler?.wait,undefined);
+ assert.equal(h.core.state.goal?.status,"active");
+ assert.equal(h.sent.length,0,"native Paseo delivery already starts the turn");
+ h.ready(); h.core.scheduler.settled(h.ctx); t.mock.timers.tick(1);
+ assert.equal(h.sent.length,1,"normal work continues without goal-resume");
+});
+
+test("message wait persists across restart and cannot revive a user pause", async t => {
+ const h = await fixture(t);
+ t.mock.timers.enable({apis:["setTimeout","Date"]});
+ h.begin(); h.core.scheduler.declare(h.ctx,{kind:"wait",reason:"SDK",deadline:new Date(Date.now()+60_000).toISOString(),message:{source_agent_id:"sdk",prefix:"SDK_READY"}});
+ h.core.scheduler.settled(h.ctx); h.core.scheduler.shutdown();
+ const resumed=await fixture(t,undefined,"owner",h.cwd);
+ resumed.core.scheduler.restore(resumed.ctx); t.mock.timers.tick(10_000);
+ assert.equal(resumed.sent.length,0);
+ assert.equal(resumed.core.state.goal?.scheduler?.wait?.message?.prefix,"SDK_READY");
+ resumed.core.pauseActiveGoal(resumed.ctx);
+ resumed.core.scheduler.message(resumed.ctx,{role:"user",content:'<paseo-system kind="agent-message" source-agent-id="sdk">SDK_READY abc</paseo-system>'});
+ t.mock.timers.tick(1);
+ resumed.core.scheduler.settled(resumed.ctx); t.mock.timers.tick(1);
+ assert.equal(resumed.core.state.goal?.status,"paused");
+ assert.equal(resumed.sent.length,0,"producer cannot override user interruption");
+});
+
