+async function assertReusedLaunchMetadata(sourceId: string, resumedId: string, stage2RunId: string): Promise<void> {
+	const source = readJson<AsyncStatus>(path.join(ASYNC_DIR, sourceId, "status.json"))!;
+	const resumed = await pollFor("both reused step identities", () => {
+		const status = readJson<AsyncStatus>(path.join(ASYNC_DIR, resumedId, "status.json"));
+		return status?.steps?.find((step) => step.workflowKey === "stage2")?.runId === stage2RunId ? status : undefined;
+	}, 30_000);
+	for (const key of ["stage1", "stage2"]) {
+		const original = source.steps!.find((step) => step.workflowKey === key)!;
+		const reused = resumed.steps!.find((step) => step.workflowKey === key)!;
+		assert.ok(original.sessionFile, `${key} originally published a session file`);
+		assert.ok(original.sessionName, `${key} originally published a session name`);
+		assert.equal(reused.runId, original.runId, `${key} reuses its child`);
+		assert.equal(reused.sessionFile, original.sessionFile, `${key} publishes its original file before gate release`);
+		assert.equal(reused.sessionName, original.sessionName, `${key} publishes its original name before gate release`);
+		assert.equal(reused.parentWorkflowRunId, resumedId, `${key} belongs to the resumed workflow`);
+	}
+	const child = readJson<AsyncStatus>(path.join(ASYNC_DIR, stage2RunId, "status.json"))!;
+	assert.equal(child.state, "running", "reattachment publishes metadata while the child is held");
+	assert.equal(child.parentWorkflowRunId, sourceId, "reattachment does not rewrite child ownership");
+}
