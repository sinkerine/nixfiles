index 0b6f887..f7cc96e 100644
--- a/src/core/dedup.ts
+++ b/src/core/dedup.ts
@@ -1,6 +1,34 @@
 import type { RecallHit } from "./client.js";
+import type { RecallMinScores } from "./config.js";
 import { contentWords, jaccard } from "./policy.js";
 
+const SCORE_FIELDS = ["final", "reranker", "semantic", "keyword"] as const;
+
+/**
+ * Drops recall hits whose reported per-stage score falls below any configured
+ * floor. Hits without a `scores` object, or missing a configured field, are
+ * preserved so older servers or BM25-only responses are not accidentally emptied.
+ */
+export function filterByMinScores(
+  hits: readonly RecallHit[],
+  minScores?: RecallMinScores,
+): RecallHit[] {
+  if (!minScores) return [...hits];
+  const floors = SCORE_FIELDS.flatMap((field) => {
+    const floor = minScores[field];
+    return typeof floor === "number" ? [[field, floor] as const] : [];
+  });
+  if (!floors.length) return [...hits];
+  return hits.filter((hit) => {
+    if (!hit.scores) return true;
+    for (const [field, floor] of floors) {
+      const value = hit.scores[field];
+      if (typeof value === "number" && value < floor) return false;
+    }
+    return true;
+  });
+}
+
 /** Smallest word set for which containment alone marks a duplicate. */
 const MIN_CONTAINED_WORDS = 6;
 const CONTAINMENT = 0.9;
