@@ -0,0 +1,268 @@
+import { createHash, randomUUID } from "node:crypto";
+import {
+  mkdirSync,
+  readdirSync,
+  readFileSync,
+  renameSync,
+  unlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { join } from "node:path";
+import type { CircuitBreaker } from "./breaker.js";
+import type { HindsightClient, HindsightError } from "./client.js";
+import {
+  type CheckpointRequest,
+  type CheckpointSegmentReceipt,
+  CheckpointWriter,
+  type UnflushedCheckpoint,
+} from "./writer.js";
+
+const DEFAULT_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
+const DEFAULT_MAX_FILES = 100;
+
+export interface QueuedCheckpoint extends UnflushedCheckpoint {
+  version: 1;
+  queuedAt: string;
+  destination: string;
+  sessionId: string;
+  attempts: number;
+  lastError?: string;
+}
+
+export interface RetainQueueOptions {
+  dir: string;
+  now?: () => number;
+  maxAgeMs?: number;
+  maxFiles?: number;
+}
+
+function fileNameFor(destination: string, sessionId: string): string {
+  const destPart = destination.replace(/[^a-zA-Z0-9]/g, "").slice(0, 12) || "d";
+  const sessPart = createHash("sha256")
+    .update(sessionId)
+    .digest("hex")
+    .slice(0, 16);
+  return `${destPart}-${sessPart}.json`;
+}
+
+function isValidQueued(value: unknown): value is QueuedCheckpoint {
+  if (!value || typeof value !== "object") return false;
+  const v = value as Record<string, unknown>;
+  if (v.version !== 1) return false;
+  if (
+    typeof v.queuedAt !== "string" ||
+    typeof v.destination !== "string" ||
+    typeof v.sessionId !== "string" ||
+    typeof v.attempts !== "number"
+  )
+    return false;
+  if (!v.request || typeof v.request !== "object") return false;
+  const req = v.request as Record<string, unknown>;
+  if (typeof req.sessionId !== "string" || !Array.isArray(req.segments))
+    return false;
+  if (!Array.isArray(v.ackedHashes) || !Array.isArray(v.knownIndices))
+    return false;
+  return true;
+}
+
+export class RetainQueue {
+  private readonly now: () => number;
+  private readonly maxAgeMs: number;
+  private readonly maxFiles: number;
+
+  constructor(private readonly opts: RetainQueueOptions) {
+    this.now = opts.now ?? Date.now;
+    this.maxAgeMs = opts.maxAgeMs ?? DEFAULT_MAX_AGE_MS;
+    this.maxFiles = opts.maxFiles ?? DEFAULT_MAX_FILES;
+  }
+
+  private pathFor(destination: string, sessionId: string): string {
+    return join(this.opts.dir, fileNameFor(destination, sessionId));
+  }
+
+  private readEntry(path: string): QueuedCheckpoint | undefined {
+    try {
+      const parsed: unknown = JSON.parse(readFileSync(path, "utf8"));
+      if (!isValidQueued(parsed)) {
+        this.unlinkQuiet(path);
+        return undefined;
+      }
+      const queuedMs = Date.parse(parsed.queuedAt);
+      if (!Number.isFinite(queuedMs) || this.now() - queuedMs > this.maxAgeMs) {
+        this.unlinkQuiet(path);
+        return undefined;
+      }
+      return parsed;
+    } catch {
+      return undefined;
+    }
+  }
+
+  private unlinkQuiet(path: string): void {
+    try {
+      unlinkSync(path);
+    } catch {}
+  }
+
+  private pruneExcess(): void {
+    try {
+      const files = readdirSync(this.opts.dir).filter((name) =>
+        name.endsWith(".json"),
+      );
+      if (files.length <= this.maxFiles) return;
+      const entries: Array<{ path: string; queuedMs: number }> = [];
+      for (const name of files) {
+        const path = join(this.opts.dir, name);
+        const entry = this.readEntry(path);
+        if (entry)
+          entries.push({ path, queuedMs: Date.parse(entry.queuedAt) || 0 });
+      }
+      entries.sort((a, b) => a.queuedMs - b.queuedMs);
+      const excess = entries.length - this.maxFiles;
+      for (let i = 0; i < excess; i++) {
+        const target = entries[i];
+        if (target) this.unlinkQuiet(target.path);
+      }
+    } catch {}
+  }
+
+  save(input: {
+    destination: string;
+    sessionId: string;
+    snapshot: UnflushedCheckpoint;
+    attempts?: number;
+    lastError?: string;
+  }): void {
+    try {
+      mkdirSync(this.opts.dir, { recursive: true, mode: 0o700 });
+      const target = this.pathFor(input.destination, input.sessionId);
+      const existing = this.readEntry(target);
+      const record: QueuedCheckpoint = {
+        version: 1,
+        queuedAt: new Date(this.now()).toISOString(),
+        destination: input.destination,
+        sessionId: input.sessionId,
+        request: structuredClone(input.snapshot.request),
+        ackedHashes: input.snapshot.ackedHashes.map(([idx, hash]) => [
+          idx,
+          hash,
+        ]),
+        knownIndices: [...input.snapshot.knownIndices],
+        attempts: input.attempts ?? existing?.attempts ?? 0,
+        ...(input.lastError ? { lastError: input.lastError } : {}),
+      };
+      const tmp = `${target}.${process.pid}.${randomUUID().slice(0, 8)}.tmp`;
+      try {
+        writeFileSync(tmp, JSON.stringify(record), {
+          encoding: "utf8",
+          mode: 0o600,
+        });
+        renameSync(tmp, target);
+      } catch {
+        this.unlinkQuiet(tmp);
+      }
+      this.pruneExcess();
+    } catch {}
+  }
+
+  remove(destination: string, sessionId: string): void {
+    this.unlinkQuiet(this.pathFor(destination, sessionId));
+  }
+
+  list(destination: string): QueuedCheckpoint[] {
+    try {
+      const files = readdirSync(this.opts.dir).filter((name) =>
+        name.endsWith(".json"),
+      );
+      const matching: QueuedCheckpoint[] = [];
+      for (const name of files) {
+        const entry = this.readEntry(join(this.opts.dir, name));
+        if (entry && entry.destination === destination) matching.push(entry);
+      }
+      matching.sort(
+        (a, b) => (Date.parse(a.queuedAt) || 0) - (Date.parse(b.queuedAt) || 0),
+      );
+      return matching;
+    } catch {
+      return [];
+    }
+  }
+
+  count(destination: string): number {
+    return this.list(destination).length;
+  }
+}
+
+export interface DrainQueueOptions {
+  queue: RetainQueue;
+  destination: string;
+  client: Pick<HindsightClient, "retain" | "deleteDocument">;
+  breaker: CircuitBreaker;
+  timeoutMs: number;
+  signal?: AbortSignal;
+  sleep?: (ms: number) => Promise<void>;
+  waitForOperation?: (operationId: string) => Promise<void>;
+  /** When set, entries for this session are handed to the callback instead of a standalone writer. */
+  currentSessionId?: string;
+  onCurrentSession?: (request: CheckpointRequest) => void;
+}
+
+export interface DrainQueueResult {
+  flushed: number;
+  remaining: number;
+}
+
+export async function drainQueuedCheckpoints(
+  opts: DrainQueueOptions,
+): Promise<DrainQueueResult> {
+  const entries = opts.queue.list(opts.destination);
+  let flushed = 0;
+  for (const entry of entries) {
+    if (opts.signal?.aborted || opts.breaker.isOpen()) break;
+    if (
+      opts.currentSessionId &&
+      entry.sessionId === opts.currentSessionId &&
+      opts.onCurrentSession
+    ) {
+      opts.onCurrentSession(entry.request);
+      continue;
+    }
+    const receipts = new Map<number, CheckpointSegmentReceipt>();
+    for (const index of entry.knownIndices)
+      receipts.set(index, { index, hash: null });
+    for (const [index, hash] of entry.ackedHashes)
+      receipts.set(index, { index, hash });
+
+    let outcome: { ok: boolean; error?: HindsightError } | undefined;
+    const writer = new CheckpointWriter({
+      client: opts.client,
+      timeoutMs: opts.timeoutMs,
+      breaker: opts.breaker,
+      sleep: opts.sleep,
+      waitForOperation: opts.waitForOperation,
+      onResult: (r) => {
+        outcome = { ok: r.ok, error: r.error };
+      },
+    });
+    writer.restoreSegments(entry.sessionId, receipts);
+    writer.submit(entry.request);
+    await writer.flush();
+
+    if (outcome?.ok) {
+      opts.queue.remove(opts.destination, entry.sessionId);
+      flushed++;
+    } else if (outcome?.error?.kind !== "cancelled") {
+      const snapshot = writer.unflushed();
+      if (snapshot)
+        opts.queue.save({
+          destination: opts.destination,
+          sessionId: entry.sessionId,
+          snapshot,
+          attempts: entry.attempts + 1,
+          lastError: outcome?.error?.message,
+        });
+      else opts.queue.remove(opts.destination, entry.sessionId);
+    }
+  }
+  return { flushed, remaining: opts.queue.count(opts.destination) };
+}
