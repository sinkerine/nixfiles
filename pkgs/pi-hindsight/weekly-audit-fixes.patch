+import { segmentMessages } from "../../src/core/transcript.js";
+import type { CheckpointRequest } from "../../src/core/writer.js";
+
+const timestamp = "2026-11-25T00:00:00Z";
+function request(text: string, sessionId = "s1"): CheckpointRequest {
+  return {
+    sessionId,
+    segments: segmentMessages([{ entryId: "e1", timestamp, text }], 100),
+    tags: ["harness:pi", "project:demo", `session:${sessionId}`],
+    context: "Pi coding-agent session in project demo",
+    metadata: { harness: "pi", project: "demo", session_id: sessionId },
+    observationScopes: [["project:demo"]],
+  };
+}
+
+let dir: string;
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "hindsight-queue-"));
+});
+afterEach(() => {
+  rmSync(dir, { recursive: true, force: true });
+});
+
+it("persists, lists by destination, replaces per session, and prunes expired or corrupted files", () => {
+  let now = Date.parse("2026-11-25T00:00:00Z");
+  const queue = new RetainQueue({
+    dir,
+    now: () => now,
+    maxAgeMs: 60_000,
+    maxFiles: 2,
+  });
+  queue.save({
+    destination: "dest-a",
+    sessionId: "s1",
+    snapshot: {
+      request: request("v1", "s1"),
+      ackedHashes: [],
+      knownIndices: [],
+    },
+  });
+  now += 1000;
+  queue.save({
+    destination: "dest-a",
+    sessionId: "s1",
+    snapshot: {
+      request: request("v2", "s1"),
+      ackedHashes: [],
+      knownIndices: [],
+    },
+  });
+  now += 1000;
+  queue.save({
+    destination: "dest-b",
+    sessionId: "s2",
+    snapshot: {
+      request: request("other", "s2"),
+      ackedHashes: [],
+      knownIndices: [],
+    },
+  });
+  writeFileSync(join(dir, "corrupt.json"), "{bad");
+
+  const listA = queue.list("dest-a");
+  expect(listA).toHaveLength(1);
+  expect(listA[0]?.request.segments[0]?.content).toBe("v2");
+  expect(queue.count("dest-b")).toBe(1);
+
+  now += 1000;
+  queue.save({
+    destination: "dest-a",
+    sessionId: "s3",
+    snapshot: {
+      request: request("v3", "s3"),
+      ackedHashes: [],
+      knownIndices: [],
+    },
+  });
+  // maxFiles=2 pruned oldest (s1), leaving s2 and s3
+  expect(queue.list("dest-a").map((e) => e.sessionId)).toEqual(["s3"]);
+
+  now += 100_000;
+  expect(queue.list("dest-a")).toHaveLength(0);
+});
+
+it("drains queued checkpoints, deletes abandoned segments, and updates partial progress on failure", async () => {
+  const queue = new RetainQueue({ dir });
+  const req = request("queued message", "s1");
+  queue.save({
+    destination: "dest",
+    sessionId: "s1",
+    snapshot: {
+      request: req,
+      ackedHashes: [],
+      knownIndices: [0, 1],
